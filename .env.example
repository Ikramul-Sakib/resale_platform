# =============================================================================
# ValuLens Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# Django
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL — required, no SQLite)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://valulens_user:valulens_pass@localhost:5432/valulens_dev

# For production, use a separate database:
# DATABASE_URL=postgres://valulens_prod_user:STRONG_PASSWORD@db-host:5432/valulens_prod

# Redis (optional in dev — Celery runs eagerly without it)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Recognition provider
# Options: mock (default for dev)
# -----------------------------------------------------------------------------
RECOGNITION_PROVIDER=mock

# Listing generator provider
# Options: template (default, no external deps)
# -----------------------------------------------------------------------------
LISTING_GENERATOR_PROVIDER=template

# Image upload limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Guest scan settings
# -----------------------------------------------------------------------------
GUEST_SCAN_RETENTION_HOURS=24
GUEST_SCAN_RATE_LIMIT=10

# Email (dev uses console backend by default)
# -----------------------------------------------------------------------------
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@valulens.com

# Production-only settings
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# SECURE_SSL_REDIRECT=True
